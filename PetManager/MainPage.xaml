<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PetManager.MainPage"
             xmlns:local="clr-namespace:PetManager"
             Loaded="ContentPage_Loaded">

    <ContentPage.BindingContext>
        <local:MainPageViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <local:BirthDateToAgeConverter x:Key="AgeConverter" />

        <DataTemplate x:Key="petsItem" x:DataType="local:Pet">
            <Border Margin="5" Padding="5"
    Stroke="Brown" StrokeThickness="2" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout>
                    <Label FontSize="Medium" FontAttributes="Bold" Text="{Binding Name}"/>
                    <Label FontSize="Small" Text="{Binding Species}"
                           IsVisible="{Binding 
                        BindingContext.IsFullViewEnabled, Source={RelativeSource 
                        AncestorType={x:Type ContentPage}}}"/>
                    <Label FontSize="Small" Text="{Binding BirthDate,
                        Converter={StaticResource AgeConverter},
                        StringFormat='{0} year(s) old'}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"  WidthRequest="300" RowSpacing="10"
          x:DataType="local:MainPageViewModel">
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center"
                               x:Name="buttonArea">
            <Button Text="New" Command="{Binding NewPetCommand}"/>
            <Button Text="Edit" Command="{Binding EditSelectedPetCommand}" />
            <Button Text="Delete" Command="{Binding DeletePetCommand}"/>
            <Button Text="Details"
                    Command="{Binding ShowPetDetailsCommand}" />
        </HorizontalStackLayout>
        <HorizontalStackLayout Spacing="10" Grid.Row="1">
            <Label Text="Details View"
                   VerticalOptions="Center" />
            <Switch IsToggled="{Binding IsFullViewEnabled}" />
        </HorizontalStackLayout>
        
        <Border StrokeThickness="5" Stroke="Orange" StrokeShape="RoundRectangle 10"
            Grid.Row="1">
            <CollectionView ItemsSource="{Binding Pets}" 
                            SelectedItem="{Binding SelectedPet}"
                            SelectionMode="Single"
                            BackgroundColor="LightYellow" 
                            x:Name="petsCollectionView"
                            ItemTemplate="{StaticResource petsItem}">

            </CollectionView>
        </Border>
        

    </Grid>

</ContentPage>
